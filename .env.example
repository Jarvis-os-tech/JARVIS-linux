# ==============================================================================
# J.A.R.V.I.S. MULTI-MODEL & LIVE STREAM CONFIGURATION
# ==============================================================================

# 1. Google Gemini API Key (Required)
# Powers Real-Time Bidirectional Voice Streaming & Multimodal Camera/Screen Vision
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. NVIDIA NIM API Key (Required for Deep Brain & Complex Reasoning)
# Powers Primary Reasoning Brain across all 5 Agent Personas:
# - J.A.R.V.I.S. (CEO)        : Nemotron-3-Ultra-550B -> Fallback: Nemotron-3.5-Lightning-30B-A3B
# - F.R.I.D.A.Y. (Net Leader) : Nemotron-3-Ultra-550B -> Fallback: Llama-3.1-70b-instruct
# - U.L.T.R.O.N. (Security)   : Nemotron-3-Ultra-550B -> Fallback: GLM-5.2
# - E.D.I.T.H. (Architecture) : Mistral Large 3       -> Fallback: Llama-3.3-70b-instruct
# - K.A.R.E.N. (Automation)   : Nemotron-3-Ultra-550B -> Fallback: Nemotron-3.5-Lightning-30B-A3B
NVIDIA_API_KEY="your_nvidia_nim_api_key_here"
# Optional Alias:
# NVIDIA_NIM_API_KEY="your_nvidia_nim_api_key_here"

# 3. Groq Cloud API Key (Required for Ultra-Fast Microsecond Execution & Fallback)
# Powers Sub-25ms Tool Calls & Instant Failover Insurance (Llama 3.3 70B Versatile / Llama 3.1 8B)
GROQ_API_KEY="your_groq_api_key_here"

# 4. Host Server & Application URL
PORT=3000
APP_URL="http://localhost:3000"
